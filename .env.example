# Verificacion y envio mediante WhatsApp Cloud API.
WHATSAPP_VERIFY_TOKEN=replace-with-meta-verify-token
WHATSAPP_ACCESS_TOKEN=replace-with-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-whatsapp-phone-number-id

# Notificaciones al doctor. Reservado para el corte 011; el runtime actual aun no
# consume estas variables.
DOCTOR_NOTIFICATIONS_ENABLED=false
DOCTOR_WHATSAPP_NUMBER=

# Persistencia local del MVP.
DATABASE_PATH=data/chatbot.sqlite3

# Proveedor principal de agenda. `fake` es el valor seguro para desarrollo y pruebas.
CALENDAR_PROVIDER=fake
# Selector incremental para consultar disponibilidad con Google sin activar
# todavia las operaciones de escritura.
CALENDAR_AVAILABILITY_PROVIDER=primary
GOOGLE_CALENDAR_IDS=replace-with-calendar-id
GOOGLE_CALENDAR_AUTH=service_account
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-calendar-service-account.json
GOOGLE_SERVICE_ACCOUNT_SUBJECT=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_CALENDAR_TIMEZONE=UTC
GOOGLE_CALENDAR_BASE_URL=https://www.googleapis.com/calendar/v3
GOOGLE_CALENDAR_TIMEOUT_SECONDS=20

# Horario laboral. Los dias usan ISO weekday de Python: lunes=0, domingo=6.
BUSINESS_WORKDAYS=0,1,2,3,4
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=17:00

# Agente LLM basico. Proveedores soportados: groq y openrouter.
LLM_PROVIDER=groq
LLM_API_KEY=replace-with-groq-api-key
LLM_MODEL=replace-with-groq-model
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=20
LLM_MAX_HISTORY_MESSAGES=30
LLM_MAX_OUTPUT_TOKENS=500
LLM_MAX_RESPONSE_CHARACTERS=4000
LLM_MAX_TOOL_ITERATIONS=3
