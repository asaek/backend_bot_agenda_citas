# Verificacion y envio mediante WhatsApp Cloud API.
WHATSAPP_VERIFY_TOKEN=replace-with-meta-verify-token
WHATSAPP_ACCESS_TOKEN=replace-with-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-whatsapp-phone-number-id

# Notificaciones al doctor. La entrega valida estas variables cuando la bandera
# esta activa y se ejecuta desde el ciclo del webhook.
DOCTOR_NOTIFICATIONS_ENABLED=false
# Usa E.164: codigo de pais +52 y 10 digitos. El signo + es opcional.
# Estos numeros son ficticios; reemplazalos antes de habilitar la entrega.
DOCTOR_WHATSAPP_NUMBERS=+525500000001,+525500000002

# Persistencia local del MVP.
DATABASE_PATH=data/chatbot.sqlite3

# Proveedor principal de agenda. `fake` es el valor seguro para desarrollo y pruebas.
CALENDAR_PROVIDER=fake
# Selector incremental para consultar disponibilidad con Google sin activar
# todavia las operaciones de escritura.
CALENDAR_AVAILABILITY_PROVIDER=primary
GOOGLE_CALENDAR_IDS=replace-with-calendar-id
GOOGLE_CALENDAR_AUTH=service_account
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-calendar-service-account.json
GOOGLE_SERVICE_ACCOUNT_SUBJECT=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_CALENDAR_TIMEZONE=UTC
GOOGLE_CALENDAR_BASE_URL=https://www.googleapis.com/calendar/v3
GOOGLE_CALENDAR_TIMEOUT_SECONDS=20

# Horario laboral. Los dias usan ISO weekday de Python: lunes=0, domingo=6.
BUSINESS_WORKDAYS=0,1,2,3,4
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=17:00

# Agente LLM basico. Configura las credenciales y modelos de ambos proveedores
# para alternar entre Groq y OpenAI cambiando solamente LLM_PROVIDER.
# OpenRouter se conserva como opcion existente.
LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-oss-20b
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_MODEL=replace-with-openrouter-model
# Alternativa de configuracion para un solo proveedor activo. En este modo,
# actualiza LLM_API_KEY y LLM_MODEL junto con LLM_PROVIDER al cambiar de proveedor.
# LLM_API_KEY=replace-with-active-provider-api-key
# LLM_MODEL=replace-with-active-provider-model-id
# `LLM_MODEL` es el ID del proveedor activo; con OpenAI, usa gpt-oss-20b.
# Las URLs predeterminadas se seleccionan por proveedor. Solo configura estas
# variables si necesitas reemplazar el endpoint oficial.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=20
LLM_MAX_HISTORY_MESSAGES=30
LLM_MAX_OUTPUT_TOKENS=500
LLM_MAX_RESPONSE_CHARACTERS=4000
LLM_MAX_TOOL_ITERATIONS=3
# Evaluacion JSON del motivo antes de crear una cita. Activa por defecto.
LLM_REASON_EVALUATION_ENABLED=true

# Diagnostico temporal para desarrollo. Solo se muestra a estos remitentes.
# Incluye tipo de error, codigo HTTP o codigo seguro de agenda; no contenido crudo.
DEBUG_MODE=false
DEBUG_WHATSAPP_NUMBERS=
